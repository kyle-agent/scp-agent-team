# ---- AG-UI Adapter -----------------------------------------------------------
PORT=8090

# Required. The adapter refuses to start without it - MCP and Portal access are
# never anonymous (SPEC 16).
SCP_API_TOKEN=dev-token

# Where kagent's A2A endpoint lives. In a cluster this is the kagent controller
# service on port 8083:
#   kubectl -n kagent port-forward svc/kagent-controller 8083:8083
# KAGENT_BASE_URL=http://127.0.0.1:8083
KAGENT_BASE_URL=http://127.0.0.1:8099

# Mock mode: point the adapter at the bundled mock A2A server instead of a
# cluster. The adapter's real A2A client and event mapper still run.
MOCK_KAGENT=true
MOCK_KAGENT_PORT=8099

AUDIT_FILE=./audit/agent-access.jsonl
CORS_ORIGINS=http://localhost:5173
RUN_TIMEOUT_MS=180000

# Forward the end user's identity to kagent instead of only the service token.
PROPAGATE_USER_IDENTITY=false

# ---- Portal ------------------------------------------------------------------
VITE_ADAPTER_URL=http://127.0.0.1:8090
VITE_SCP_API_TOKEN=dev-token
VITE_SCP_USER=portal-dev-user
