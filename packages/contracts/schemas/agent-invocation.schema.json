{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scp.internal/contracts/agent-invocation.schema.json",
  "title": "AgentInvocation",
  "description": "One request to run a shared SCP agent. Identical for every access mode.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "agent", "task", "actor", "correlation"],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "agent": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "task": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "project": { "type": "string" },
        "service": { "type": "string" },
        "environment": { "type": "string" },
        "namespace": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "content"],
        "properties": {
          "name": { "type": "string" },
          "media_type": { "type": "string" },
          "content": { "type": "string", "maxLength": 200000 }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "user_id"],
      "properties": {
        "type": { "enum": ["local-agent", "portal"] },
        "user_id": { "type": "string", "minLength": 1 },
        "client": { "type": "string", "description": "e.g. codex, claude-code, cursor, scp-portal" }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id"],
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string" },
        "parent_run_id": { "type": "string" }
      }
    }
  }
}
