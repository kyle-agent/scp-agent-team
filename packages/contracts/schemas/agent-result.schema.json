{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scp.internal/contracts/agent-result.schema.json",
  "title": "AgentResult",
  "description": "Structured result of an agent run. Reused for MCP return, Portal rendering, AG-UI state, tests and audit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "trace"],
  "properties": {
    "status": { "enum": ["completed", "failed", "cancelled", "needs_input"] },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "severity"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
          "detail": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["metric", "log", "manifest", "document", "command_output", "link"] },
          "label": { "type": "string" },
          "source": { "type": "string", "description": "Tool or system the evidence came from." },
          "content": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action"],
        "properties": {
          "id": { "type": "string" },
          "action": { "type": "string" },
          "rationale": { "type": "string" },
          "risk": { "enum": ["read-only", "business-write", "infra-write"] }
        }
      }
    },
    "requested_capabilities": {
      "type": "array",
      "description": "Capabilities the agent wants but is not allowed to execute itself (e.g. createIncident, executeRunbook).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability"],
        "properties": {
          "capability": { "type": "string" },
          "parameters": { "type": "object", "additionalProperties": true },
          "requires_approval": { "type": "boolean" }
        }
      }
    },
    "followups": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id", "agent_run_id"],
      "properties": {
        "trace_id": { "type": "string" },
        "agent_run_id": { "type": "string" },
        "request_id": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
